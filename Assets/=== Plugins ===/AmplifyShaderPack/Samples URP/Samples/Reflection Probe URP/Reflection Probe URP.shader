				float3 PositionWS = input.positionWS;
				float3 PositionRWS = GetCameraRelativePositionWS( PositionWS );
				float4 ScreenPosNorm = float4( GetNormalizedScreenSpaceUV( input.positionCS ), input.positionCS.zw );
				float4 ClipPos = ComputeClipSpacePosition( ScreenPosNorm.xy, input.positionCS.z ) * input.positionCS.w;

				float2 temp_output_133_0_g1 = ( ( input.ase_texcoord1.xy * (_MainUVs).xy ) + (_MainUVs).zw );
				float4 tex2DNode21_g1 = tex2D( _MainTex, temp_output_133_0_g1 );
				float MapBaseColorAlpha107_g1 = tex2DNode21_g1.a;
				

				surfaceDescription.Alpha = MapBaseColorAlpha107_g1;
				surfaceDescription.AlphaClipThreshold = _AlphaCutoffBias;

				#if defined( ASE_DEPTH_WRITE_ON )
					float DeviceDepth = input.positionCS.z;
				#endif

